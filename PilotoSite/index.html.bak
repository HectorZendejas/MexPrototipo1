<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>mex — Soluções digitais pra mexer com o seu negócio</title>
<meta name="description" content="mex: agência de soluções digitais especializada em criação de sites, gestão de redes, tráfego, copywriting e design. Começamos com advogados, hoje mexemos com qualquer negócio.">

<!-- Google Fonts: Fredoka (impacto/Block Berthold), Playfair Display (editorial), Poppins (Gilroy fallback / UI) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

