</head>
<body>

<div class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress-track"></div>
  <img src="Imagens/mex-icon.png" alt="" class="scroll-progress-dino">
</div>

<div class="corner-mascot" id="cornerMascot" aria-hidden="true">
