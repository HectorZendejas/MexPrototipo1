</div>

<a class="skip-link" href="#main">Pular para o conteúdo</a>

<!-- ===================== HEADER ===================== -->
<header class="site-header" id="topo">
  <div class="container header-inner">
    <a href="#topo" class="brand" aria-label="mex — início">
      <span class="brand-anim">
        <span class="brand-intro">
          <span class="brand-burst" aria-hidden="true"></span>
          <img src="Imagens/mex-icon.png" alt="" class="brand-icon">
        </span>
        <span class="brand-word" aria-hidden="true">
          <span class="brand-letter" style="--i:0">m</span>
          <span class="brand-letter" style="--i:1">e</span>
          <span class="brand-letter" style="--i:2">x</span>
        </span>
      </span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Navegação principal">
      <ul>
        <li><a href="#o-que-fazemos">O que fazemos</a></li>
        <li><a href="#diferencial">Diferencial</a></li>
        <li><a href="#sobre">Sobre nós</a></li>
        <li><a href="#contato">Contato</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a href="#contato" class="btn btn-cta">Fale conosco</a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="main-nav" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main id="main">

  <!-- ===================== HERO ===================== -->
  <section class="hero section-purple" aria-labelledby="hero-title">
    <div class="hero-mascot" aria-hidden="true">
      <img src="Imagens/mex-icon.png" alt="" class="hero-bg-icon">
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="eyebrow fade-in">soluções digitais</p>
      <h1 id="hero-title" class="hero-title fade-in">A gente mexe com ideias<br>e gera resultado</h1>
      <p class="hero-subtitle fade-in">
        A mex cuida do marketing do seu negócio: da estratégia ao resultado,
        com soluções digitais sob medida pra cada desafio.
      </p>
      <div class="hero-actions fade-in">
        <a href="#contato" class="btn btn-cta btn-lg">Vamos mexer</a>
        <a href="#o-que-fazemos" class="btn btn-ghost btn-lg">O que fazemos</a>
      </div>
    </div>
  </section>

  <!-- ===================== O QUE A GENTE FAZ ===================== -->
  <section class="section-purple orbit-section" id="o-que-fazemos" aria-labelledby="orbit-title">
    <div class="texture-cloud" aria-hidden="true"></div>
    <div class="texture-grid" aria-hidden="true"></div>

    <div class="container">
      <div class="orbit-wrap fade-in">

        <!-- Desktop / tablet: radial orbit layout -->
        <div class="orbit" aria-hidden="false">
          <svg class="orbit-arrows" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <g class="orbit-arrow" style="--d:0s">
              <path class="orbit-path" d="M45.55,37.78 Q47.99,27.09 50,18"></path>
              <path class="orbit-arrowhead" transform="translate(50,18) rotate(-77.55)" d="M0,0 L-2.8,-1.4 L-2.8,1.4 Z"></path>
            </g>
            <g class="orbit-arrow" style="--d:.08s">
              <path class="orbit-path" d="M58.36,40.04 Q68.84,36.80 77.71,34"></path>
              <path class="orbit-arrowhead" transform="translate(77.71,34) rotate(-17.52)" d="M0,0 L-2.8,-1.4 L-2.8,1.4 Z"></path>
            </g>
            <g class="orbit-arrow" style="--d:.16s">
              <path class="orbit-path" d="M62.81,52.26 Q70.84,59.73 77.71,66"></path>
              <path class="orbit-arrowhead" transform="translate(77.71,66) rotate(42.42)" d="M0,0 L-2.8,-1.4 L-2.8,1.4 Z"></path>
            </g>
            <g class="orbit-arrow" style="--d:.24s">
              <path class="orbit-path" d="M54.45,62.22 Q52.01,72.91 50,82"></path>
              <path class="orbit-arrowhead" transform="translate(50,82) rotate(102.45)" d="M0,0 L-2.8,-1.4 L-2.8,1.4 Z"></path>
            </g>
            <g class="orbit-arrow" style="--d:.32s">
              <path class="orbit-path" d="M41.64,59.96 Q31.16,63.20 22.29,66"></path>
              <path class="orbit-arrowhead" transform="translate(22.29,66) rotate(162.48)" d="M0,0 L-2.8,-1.4 L-2.8,1.4 Z"></path>
            </g>
            <g class="orbit-arrow" style="--d:.4s">
              <path class="orbit-path" d="M37.19,47.74 Q29.16,40.27 22.29,34"></path>
              <path class="orbit-arrowhead" transform="translate(22.29,34) rotate(-137.58)" d="M0,0 L-2.8,-1.4 L-2.8,1.4 Z"></path>
            </g>
          </svg>

          <h2 id="orbit-title" class="orbit-title">O que a<br>gente faz?</h2>

          <ul class="orbit-items" role="list">
            <li>
              <button type="button" class="orbit-item orbit-item--top" style="--x:50%; --y:6%;" aria-expanded="false">
                <span class="orbit-item-label">Desenvolvimento<br>de sites</span>
                <span class="orbit-tooltip">Criamos sites rápidos, modernos e pensados pra converter visitantes em clientes.</span>
              </button>
            </li>
            <li>
              <button type="button" class="orbit-item orbit-item--top" style="--x:88.1%; --y:28%;" aria-expanded="false">
                <span class="orbit-item-label">Gestão<br>de redes</span>
                <span class="orbit-tooltip">Cuidamos do dia a dia das suas redes sociais, do planejamento à publicação.</span>
              </button>
            </li>
            <li>
              <button type="button" class="orbit-item orbit-item--bottom" style="--x:88.1%; --y:72%;" aria-expanded="false">
                <span class="orbit-item-label">Tráfego</span>
                <span class="orbit-tooltip">Gerenciamos campanhas pagas pra levar o público certo até você.</span>
              </button>
            </li>
            <li>
              <button type="button" class="orbit-item orbit-item--bottom" style="--x:50%; --y:94%;" aria-expanded="false">
                <span class="orbit-item-label">Copywrite</span>
                <span class="orbit-tooltip">Escrevemos textos que comunicam com clareza e vendem sem parecer forçado.</span>
              </button>
            </li>
            <li>
              <button type="button" class="orbit-item orbit-item--bottom" style="--x:11.9%; --y:72%;" aria-expanded="false">
                <span class="orbit-item-label">Design</span>
                <span class="orbit-tooltip">Damos identidade visual e cara profissional pra sua marca.</span>
              </button>
            </li>
            <li>
              <button type="button" class="orbit-item orbit-item--top" style="--x:11.9%; --y:28%;" aria-expanded="false">
                <span class="orbit-item-label">Análise de<br>resultados</span>
                <span class="orbit-tooltip">Acompanhamos métricas e dados pra guiar cada decisão de marketing com precisão.</span>
              </button>
            </li>
          </ul>
        </div>

        <!-- Mobile: simple card grid, same 6 services -->
        <div class="orbit-mobile">
          <h2 class="orbit-title orbit-title--mobile">O que a gente faz?</h2>
          <ul class="service-cards" role="list">
            <li>
              <button type="button" class="service-card" aria-expanded="false">
                <span class="service-card-top"><span class="service-arrow" aria-hidden="true">↗</span>Desenvolvimento de sites</span>
                <span class="service-desc">Criamos sites rápidos, modernos e pensados pra converter visitantes em clientes.</span>
              </button>
            </li>
            <li>
              <button type="button" class="service-card" aria-expanded="false">
                <span class="service-card-top"><span class="service-arrow" aria-hidden="true">↗</span>Gestão de redes</span>
                <span class="service-desc">Cuidamos do dia a dia das suas redes sociais, do planejamento à publicação.</span>
              </button>
            </li>
            <li>
              <button type="button" class="service-card" aria-expanded="false">
                <span class="service-card-top"><span class="service-arrow" aria-hidden="true">↗</span>Tráfego</span>
                <span class="service-desc">Gerenciamos campanhas pagas pra levar o público certo até você.</span>
              </button>
            </li>
            <li>
              <button type="button" class="service-card" aria-expanded="false">
                <span class="service-card-top"><span class="service-arrow" aria-hidden="true">↗</span>Copywrite</span>
                <span class="service-desc">Escrevemos textos que comunicam com clareza e vendem sem parecer forçado.</span>
              </button>
            </li>
            <li>
              <button type="button" class="service-card" aria-expanded="false">
                <span class="service-card-top"><span class="service-arrow" aria-hidden="true">↗</span>Design</span>
                <span class="service-desc">Damos identidade visual e cara profissional pra sua marca.</span>
              </button>
            </li>
            <li>
              <button type="button" class="service-card" aria-expanded="false">
                <span class="service-card-top"><span class="service-arrow" aria-hidden="true">↗</span>Análise de resultados</span>
                <span class="service-desc">Acompanhamos métricas e dados pra guiar cada decisão de marketing com precisão.</span>
              </button>
